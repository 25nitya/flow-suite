
# Application environment
ENVIRONMENT=development

# Generate a secure secret before deployment
JWT_SECRET=replace-with-a-secure-random-secret

# Database and Redis
DATABASE_URL=postgresql+asyncpg://flowsuite:flowsuite@postgres:5432/flowsuite
REDIS_URL=redis://redis:6379/0

# Frontend configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost
FRONTEND_URL=http://localhost:3001

# Razorpay (optional; leave empty for demo billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo billing
BILLING_STUB_MODE=true
